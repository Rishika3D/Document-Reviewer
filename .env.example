# Required — get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional — override the default model (llama-3.3-70b-versatile)
# GROQ_MODEL=

# Optional — port the server listens on (deployment platforms set this automatically)
# PORT=5050

# Optional but RECOMMENDED in production — comma-separated list of allowed
# frontend origins, e.g. https://your-frontend.vercel.app
# ALLOWED_ORIGINS=

# Optional — only needed if you use the HuggingFace test script
# HF_TOKEN=
